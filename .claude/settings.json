{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cd server && pytest:*)",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(ruff check:*)",
      "Bash(ruff format:*)",
      "Bash(python -m build)",
      "Bash(twine check:*)",
      "Bash(pip install -e:*)",
      "Bash(uvx:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git tag:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh workflow list:*)",
      "Bash(gh workflow view:*)",
      "Bash(gh pr view:*)",
      "Bash(gh repo view:*)",
      "Bash(claude plugin:*)",
      "Bash(claude mcp list:*)",
      "Bash(podman build:*)",
      "Bash(podman run:*)",
      "Bash(podman images:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(gh workflow run:*)",
      "Bash(twine upload:*)",
      "Bash(gh repo delete:*)"
    ],
    "deny": []
  }
}
